# ============================================================
# The Family Fridge — server settings
#
# Copy to server/.env (or set these in your host's dashboard) and fill
# in. The server refuses to start with a clear list of what is missing,
# so you do not have to get this right first time.
# ============================================================

# Where this app is reachable. Must match exactly what you register as
# the redirect URL in Supabase — no trailing slash. In production it has
# to be https, or the session cookies will not be sent at all.
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# ---- Supabase (Settings → API in your project) --------------------
# The project URL and the anon/publishable key are safe to expose; they
# only ever grant what the row level security policies allow.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# The service_role key bypasses row level security. It is used for
# exactly one thing — letting an invited person into a household they
# are not a member of yet — and must never reach the browser. Treat it
# like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sessions -----------------------------------------------------
# Signs the CSRF token. Generate with: openssl rand -hex 32
# If this changes, everyone's open tab needs a reload. With more than
# one server instance, they must all share the same value.
SESSION_SECRET=

# ---- Invitation email ---------------------------------------------
# resend  — the Resend HTTP API; simplest to get working
# smtp    — any SMTP server (Fastmail, Postmark, SES, your own)
# console — prints invitation links to the log and sends nothing.
#           Fine for development, useless in production.
MAIL_TRANSPORT=console
MAIL_FROM=The Family Fridge <fridge@your-domain.example>

# MAIL_TRANSPORT=resend
RESEND_API_KEY=

# MAIL_TRANSPORT=smtp — either a URL, or the four parts
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# How long an invitation link stays good.
INVITE_TTL_DAYS=14
